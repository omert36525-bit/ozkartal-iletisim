---
const col1 = [
  { name: 'A. Yılmaz', role: 'Elazığ', service: 'iPhone Ekran', text: 'iPhone 13 ekranımı değiştirdiler. İşçilik temiz, süreç hakkında bilgilendirildim. Memnun kaldım.' },
  { name: 'M. Kaya', role: 'Elazığ', service: 'Drone Motor', text: 'DJI Mini 2 droneum motorunda problem vardı. Detaylı kontrol ettiler, sorunu açık şekilde anlattılar.' },
  { name: 'F. Şahin', role: 'Elazığ', service: 'Laptop Ekran', text: 'Laptop ekranı değişimi için gittim. Uygun süre içinde teslim aldım, herhangi bir sıkıntı yaşamadım.' },
];
const col2 = [
  { name: 'Z. Arslan', role: 'Elazığ', service: 'Şarj Girişi', text: 'Samsung telefonumun şarj girişi sorunluydu. Önce kontrol ettiler, sonra ne yapılacağı konusunda bilgi verdiler.' },
  { name: 'İ. Demir', role: 'Elazığ', service: 'Drone Bakım', text: 'Drone bakımı için her yıl uğradığım yer. Düzenli ve özenli çalışıyorlar.' },
  { name: 'A. Koç', role: 'Elazığ', service: 'Tablet Ekran', text: 'Tablet ekranı değişimi yapıldı. Süreç boyunca iletişim iyiydi, fiyat ve süre konusunda net bilgi aldım.' },
];
const col3 = [
  { name: 'K. Öztürk', role: 'Elazığ', service: 'Araç ECU', text: 'Araç beyin tamiri için geldim. Sorunu tespit ettiler, beklediğimden kısa sürede çözdüler.' },
  { name: 'S. Çelik', role: 'Elazığ', service: 'Anakart', text: 'Laptop anakartında sorun vardı, başka yerde "olmaz" dediler. Burada hallettiler, gayet iyiydi.' },
  { name: 'H. Yıldız', role: 'Elazığ', service: 'iPhone Batarya', text: 'Batarya değişimi için gittim. Hızlı ve temiz bir işlemdi, cihazı yerinde bekledim.' },
];

const allCols = [col1, col2, col3];
---

<section class="testimonials-section" aria-labelledby="testimonials-title">
  <div class="container">
    <div class="section-header reveal" style="text-align:center;max-width:540px;margin:0 auto 56px">
      <div class="section-label">
        <span style="width:6px;height:6px;background:#FF6B35;border-radius:50%;display:inline-block;box-shadow:0 0 8px #FF6B35"></span>
        Müşteri Yorumları
      </div>
      <h2 id="testimonials-title" class="section-title" style="margin:16px 0 12px">
        Bizimle<br/>
        <span class="gradient-text">Çalışanlar</span>
      </h2>
      <p class="section-sub">Daha önce hizmet aldığımız müşterilerimizin kısa notları.</p>
    </div>
  </div>

  <!-- Scroll columns — fade mask top/bottom -->
  <div class="columns-wrap">
    {allCols.map((col, ci) => (
      <div class={`scroll-col ${ci === 1 ? 'hidden-mobile' : ''} ${ci === 2 ? 'hidden-tablet' : ''}`}>
        <div class="scroll-track" style={`animation-duration:${45 + ci * 12}s`}>
          {[...col, ...col].map((r, i) => {
            const globalIdx = ci * 3 + (i % 3);
            return (
              <div class="review-card" key={i}>
                <svg class="q-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M3 21c0-7 4-13 11-13M14 21c0-7 4-13 11-13" stroke="#FF6B35" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <p class="review-text" data-cfg={`testimonial-${globalIdx}-text`}>{r.text}</p>
                <div class="review-footer">
                  <div class="review-meta">
                    <strong class="review-name" data-cfg={`testimonial-${globalIdx}-name`}>{r.name}</strong>
                    <span class="review-role" data-cfg={`testimonial-${globalIdx}-role`}>{r.role}</span>
                  </div>
                  <span class="review-service" data-cfg={`testimonial-${globalIdx}-service`}>{r.service}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <div class="container" style="margin-top:48px">
    <div class="testimonials-cta reveal" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:18px">
      <p style="font-family:'Space Grotesk',sans-serif;font-size:0.95rem;font-weight:500;color:rgba(244,244,245,0.65)">
        Cihazınızla ilgili bir konu için bize ulaşabilirsiniz.
      </p>
      <a href="#iletisim" class="btn-primary">İletişime Geç</a>
    </div>
  </div>
</section>

<style>
.testimonials-section {
  padding: 110px 0;
  background: #0f0f1c;
  border-top: 1px solid rgba(255,255,255,0.04);
}

/* Fading mask — smooth top/bottom fade */
.columns-wrap {
  display: flex;
  justify-content: center;
  gap: 16px;
  overflow: hidden;
  max-height: 620px;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  padding: 0 24px;
}

.scroll-col { flex: 1; max-width: 360px; overflow: hidden; }
.hidden-mobile { display: none; }
.hidden-tablet { display: none; }
@media (min-width: 640px)  { .hidden-mobile { display: block; } }
@media (min-width: 1024px) { .hidden-tablet { display: block; } }

/* Infinite scroll track — CSS only, no JS needed */
.scroll-track {
  display: flex;
  flex-direction: column;
  gap: 16px;
  animation: scroll-up linear infinite;
  will-change: transform;
}
.columns-wrap:hover .scroll-track,
.scroll-track:hover { animation-play-state: paused; }

@keyframes scroll-up {
  from { transform: translateY(0); }
  to   { transform: translateY(-50%); }
}

/* Mobile: pause animation, allow native scroll */
@media (max-width: 768px) {
  .columns-wrap { max-height: 480px; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .scroll-track { animation: none !important; transform: none !important; }
  .scroll-col { max-width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .scroll-track { animation: none !important; }
}

.review-card {
  background: rgba(255,255,255,0.028);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 18px;
  padding: 24px 22px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: border-color 0.3s;
  flex-shrink: 0;
}
.review-card:hover { border-color: rgba(255,107,53,0.22); }

.q-icon { opacity: 0.7; flex-shrink: 0; }

.review-text {
  font-size: 0.9rem;
  color: rgba(244,244,245,0.75);
  line-height: 1.7;
  flex: 1;
}

.review-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 12px;
  border-top: 1px solid rgba(255,255,255,0.06);
}
.review-meta { display: flex; flex-direction: column; gap: 2px; }
.review-name {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.86rem;
  font-weight: 700;
  color: #F4F4F5;
}
.review-role { font-size: 0.7rem; color: rgba(244,244,245,0.4); }
.review-service {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #FF6B35;
  padding: 3px 9px;
  background: rgba(255,107,53,0.07);
  border: 1px solid rgba(255,107,53,0.18);
  border-radius: 99px;
  white-space: nowrap;
}
</style>
