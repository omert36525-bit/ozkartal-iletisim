---
// Curated Pexels — makro çekim, gerçek tamir görselleri
const images = [
  { id: '7286009',  alt: 'Büyüteç altında devre kartı tamiri',                  span: 'tall' },
  { id: '9242896',  alt: 'Anakart üzerinde profesyonel lehim çalışması',         span: 'normal' },
  { id: '4709378',  alt: 'Hassas lehim havya ile bileşen onarımı',              span: 'normal' },
  { id: '36169774', alt: 'Yüksek çözünürlüklü devre kartı makro çekimi',         span: 'wide' },
  { id: '6636458',  alt: 'Elektronik kart komponentleri yakın plan',             span: 'normal' },
  { id: '4709370',  alt: 'Atölye masasında detaylı elektronik onarım',           span: 'normal' },
];

function pexels(id: string, w=900, h=700) {
  return `https://images.pexels.com/photos/${id}/pexels-photo-${id}.jpeg?auto=compress&cs=tinysrgb&w=${w}&h=${h}&dpr=1`;
}
---

<section id="galeri" class="gallery-section" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-header reveal" style="text-align:center;max-width:560px;margin:0 auto 56px">
      <div class="section-label">
        <span style="width:6px;height:6px;background:#FF6B35;border-radius:50%;display:inline-block;box-shadow:0 0 8px #FF6B35"></span>
        Çalışmalarımızdan
      </div>
      <h2 id="gallery-title" class="section-title" style="margin:16px 0 12px">
        İşimize<br/>
        <span class="gradient-text">Saygımız Var</span>
      </h2>
      <p class="section-sub">
        Her cihaz bizim için önemli. Mikro lehimden ekran değişimine, her detayda özen.
      </p>
    </div>

    <div class="gallery-grid">
      {images.map((img, i) => (
        <div class={`gallery-item gallery-item--${img.span} reveal reveal-d${(i % 4) + 1}`}>
          <img
            src={pexels(img.id, 900, 700)}
            alt={img.alt}
            loading="lazy"
            width="900"
            height="700"
          />
          <div class="gallery-overlay">
            <span class="gallery-label">{img.alt}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="gallery-cta reveal">
      <p class="gallery-cta-text">Cihazınız için aklınızda soru mu var?</p>
      <a href="#iletisim" class="btn-primary">İletişime Geç</a>
    </div>
  </div>
</section>

<style>
.gallery-section {
  padding: 110px 0;
  background: var(--bg);
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}
@media (min-width: 768px) {
  .gallery-grid {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 240px;
  }
  .gallery-item--tall  { grid-row: span 2; }
  .gallery-item--wide  { grid-column: span 2; }
}

.gallery-item {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: rgba(255,255,255,0.03);
}
@media (min-width: 768px) { .gallery-item { aspect-ratio: auto; } }

.gallery-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1), filter 0.4s ease;
  filter: brightness(0.85);
}
.gallery-item:hover img {
  transform: scale(1.07);
  filter: brightness(1);
}

.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(10,10,18,0.85) 0%, transparent 60%);
  opacity: 0;
  transition: opacity 0.35s ease;
  display: flex;
  align-items: flex-end;
  padding: 18px;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }

.gallery-label {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  color: rgba(244,244,245,0.95);
  letter-spacing: 0.01em;
}

.gallery-cta {
  margin-top: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 18px;
}
.gallery-cta-text {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1rem;
  font-weight: 500;
  color: rgba(244,244,245,0.7);
}
</style>
