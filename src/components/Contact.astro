---
---

<section id="iletisim" class="contact-section" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-info reveal">
        <div class="section-label" style="margin-bottom:20px">
          <span style="width:6px;height:6px;background:#FF6B35;border-radius:50%;display:inline-block;box-shadow:0 0 8px #FF6B35"></span>
          İletişim
        </div>
        <h2 id="contact-title" class="section-title">
          Bize Ulaşın,<br/>
          <span class="gradient-text">Hemen Konuşalım</span>
        </h2>
        <p class="section-sub" style="margin-top:16px;max-width:420px">
          Cihazınızla ilgili sorularınızı ve detayları paylaşın.
          En kısa sürede dönüş yapıyoruz.
        </p>

        <div class="contact-details">
          <a href="tel:+904240000000" data-cfg-href="phone" class="contact-item" aria-label="Telefon numaramız">
            <div class="contact-item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
                <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div class="contact-item-body">
              <span class="contact-item-label">Telefon</span>
              <span class="contact-item-value" data-cfg="phone">+90 (424) 000 00 00</span>
            </div>
          </a>

          <a href="mailto:info@ozkartaliletisim.com" data-cfg-href="email" class="contact-item" aria-label="E-posta adresimiz">
            <div class="contact-item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="contact-item-body">
              <span class="contact-item-label">E-posta</span>
              <span class="contact-item-value" data-cfg="email">info@ozkartaliletisim.com</span>
            </div>
          </a>

          <div class="contact-item">
            <div class="contact-item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
                <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="contact-item-body">
              <span class="contact-item-label">Adres</span>
              <span class="contact-item-value" data-cfg="address">Elazığ, Türkiye</span>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
                <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="contact-item-body">
              <span class="contact-item-label">Çalışma Saatleri</span>
              <span class="contact-item-value" data-cfg="hours">Pzt-Cmt: 09:00 - 19:00</span>
            </div>
          </div>
        </div>

        <a href="https://wa.me/904240000000" data-cfg-href="whatsapp" class="whatsapp-btn" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp ile iletişim">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp'tan Yaz
        </a>

        <!-- MapLibre interactive map — vanilla, no React -->
        <div class="map-wrap reveal" id="map-wrap">
          <div id="ozkartal-map"></div>
          <a href="https://www.google.com/maps?q=38.6810,39.2272" id="map-open-gmaps"
             class="map-cta" target="_blank" rel="noopener noreferrer"
             aria-label="Google Maps'te konumu aç">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.553 2.776A1 1 0 0022 18.882V8.118a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            Google Maps'te Aç
          </a>
        </div>
      </div>

      <div class="contact-form-wrap reveal reveal-d2">
        <form class="contact-form" novalidate aria-label="İletişim formu">
          <h3 class="form-title">Mesaj Gönder</h3>
          <p class="form-subtitle">En kısa sürede dönüş yapıyoruz.</p>

          <div class="form-row">
            <div class="form-group">
              <label for="contact-name" class="form-label">Adınız</label>
              <input type="text" id="contact-name" name="name" class="form-input"
                placeholder="Adınız Soyadınız" autocomplete="name" required
                aria-required="true"/>
            </div>
            <div class="form-group">
              <label for="contact-phone" class="form-label">Telefon</label>
              <input type="tel" id="contact-phone" name="phone" class="form-input"
                placeholder="0500 000 00 00" autocomplete="tel" required
                aria-required="true"/>
            </div>
          </div>

          <div class="form-group">
            <label for="contact-device" class="form-label">Cihaz Türü</label>
            <select id="contact-device" name="device" class="form-input form-select" required aria-required="true">
              <option value="">Seçiniz...</option>
              <option>iPhone Tamiri</option>
              <option>Samsung / Android Tamir</option>
              <option>Drone Servisi</option>
              <option>Laptop / Tablet</option>
              <option>Anakart / Elektronik</option>
              <option>Diğer</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contact-msg" class="form-label">Mesajınız</label>
            <textarea id="contact-msg" name="message" class="form-input form-textarea"
              placeholder="Cihazınızın durumu hakkında kısaca bilgi verebilirsiniz..."
              rows="4" aria-label="Mesajınız"></textarea>
          </div>

          <button type="submit" class="btn-primary form-submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
            Mesajı Gönder
          </button>

          <p class="form-privacy">Bilgileriniz yalnızca size dönüş için kullanılır.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
.contact-section {
  padding: 110px 0;
  background: var(--bg);
  border-top: 1px solid rgba(255,255,255,0.04);
}

.contact-inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 56px;
  align-items: start;
}
@media (min-width: 1024px) {
  .contact-inner { grid-template-columns: 1fr 1fr; gap: 80px; }
}

.contact-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 32px 0;
}
.contact-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  border-radius: 14px;
  transition: background 0.2s;
  text-decoration: none;
}
.contact-item:hover { background: rgba(255,255,255,0.03); }

.contact-item-icon {
  width: 46px; height: 46px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,107,53,0.08);
  border: 1px solid rgba(255,107,53,0.18);
  border-radius: 14px;
  flex-shrink: 0;
}
.contact-item-body { display: flex; flex-direction: column; gap: 2px; }
.contact-item-label {
  font-size: 0.72rem;
  color: rgba(244,244,245,0.4);
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.contact-item-value {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.95rem;
  font-weight: 600;
  color: #F4F4F5;
}

.whatsapp-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  background: #25D366;
  color: #fff;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.92rem;
  font-weight: 600;
  border-radius: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s;
  box-shadow: 0 8px 24px rgba(37,211,102,0.22);
}
.whatsapp-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(37,211,102,0.36);
  background: #20BC5A;
}

.map-wrap {
  margin-top: 24px;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(255,107,53,0.18);
  box-shadow: 0 8px 32px -8px rgba(255,107,53,0.18);
  height: 280px;
  position: relative;
  min-height: 280px;
}
#ozkartal-map {
  width: 100% !important;
  height: 100% !important;
  min-height: 280px;
  background: #0a0a12;
  position: relative;
}
.maplibregl-canvas-container,
.maplibregl-canvas { width: 100% !important; height: 100% !important; }
@media (max-width: 768px) {
  .map-wrap { height: 240px; min-height: 240px; }
}
/* MapLibre attribution styling */
.maplibregl-ctrl-attrib {
  background: rgba(10,10,18,0.7) !important;
  color: rgba(255,255,255,0.5) !important;
  font-size: 9px !important;
}
.maplibregl-ctrl-attrib a { color: rgba(255,107,53,0.7) !important; }
.maplibregl-popup-content {
  background: #1a1a2e !important;
  color: #F4F4F5 !important;
  border: 1px solid rgba(255,107,53,0.3);
  border-radius: 10px !important;
  font-family: 'DM Sans', sans-serif;
  padding: 12px 14px !important;
  box-shadow: 0 8px 24px rgba(0,0,0,0.5);
}
.maplibregl-popup-tip { border-top-color: #1a1a2e !important; border-bottom-color: #1a1a2e !important; }
.maplibregl-popup-content strong { color: #FF6B35; font-family: 'Space Grotesk',sans-serif; }
.maplibregl-ctrl-group {
  background: rgba(20,20,30,0.92) !important;
  border: 1px solid rgba(255,107,53,0.18) !important;
}
.maplibregl-ctrl-group button { background-color: transparent !important; filter: invert(0.85) hue-rotate(180deg); }
.maplibregl-ctrl-group button:hover { background-color: rgba(255,107,53,0.15) !important; }

.map-cta {
  position: absolute;
  left: 12px; bottom: 12px;
  z-index: 5;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  color: #fff;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.78rem;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  box-shadow: 0 8px 20px rgba(255,107,53,0.3);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.map-cta:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(255,107,53,0.45); }

.oz-marker {
  width: 28px; height: 28px;
  background: #FF6B35;
  border: 3px solid #fff;
  border-radius: 50%;
  box-shadow:
    0 0 0 6px rgba(255,107,53,0.25),
    0 0 24px rgba(255,107,53,0.6),
    0 4px 14px rgba(0,0,0,0.4);
  cursor: pointer;
  position: relative;
  animation: oz-pulse 4.5s ease-in-out infinite;
}
@keyframes oz-pulse {
  0%, 100% { box-shadow: 0 0 0 6px rgba(255,107,53,0.22), 0 0 22px rgba(255,107,53,0.55), 0 4px 14px rgba(0,0,0,0.4); }
  50%      { box-shadow: 0 0 0 12px rgba(255,107,53,0.06), 0 0 28px rgba(255,107,53,0.7), 0 4px 14px rgba(0,0,0,0.4); }
}

/* Form */
.contact-form-wrap {
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 22px;
  padding: 34px;
  position: relative;
  overflow: hidden;
}
.contact-form-wrap::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, #FF6B35, transparent);
  opacity: 0.6;
}

.form-title {
  font-size: 1.3rem;
  font-weight: 700;
  color: #F4F4F5;
  margin-bottom: 4px;
}
.form-subtitle {
  font-size: 0.85rem;
  color: rgba(244,244,245,0.4);
  margin-bottom: 28px;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
@media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }

.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.form-label {
  font-size: 0.8rem;
  font-weight: 600;
  font-family: 'Space Grotesk', sans-serif;
  color: rgba(244,244,245,0.6);
}
.form-input {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 13px 16px;
  color: #F4F4F5;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  width: 100%;
}
.form-input::placeholder { color: rgba(244,244,245,0.25); }
.form-input:focus {
  outline: none;
  border-color: rgba(255,107,53,0.5);
  background: rgba(255,255,255,0.06);
  box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
}
.form-select { appearance: none; cursor: pointer; }
.form-select option { background: #1a1a2e; color: #F4F4F5; }
.form-textarea { resize: vertical; min-height: 110px; }

.form-submit { width: 100%; justify-content: center; margin-top: 4px; }
.form-privacy {
  font-size: 0.72rem;
  color: rgba(244,244,245,0.25);
  text-align: center;
  margin-top: 12px;
}
</style>

<!-- MapLibre GL CSS + JS via CDN -->
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" is:inline />
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>

<script>
  /* ─── Contact form submit ─── */
  const form = document.querySelector('.contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('.form-submit') as HTMLButtonElement;
    btn.textContent = 'Gönderildi!';
    btn.style.background = '#22c55e';
    btn.style.boxShadow = '0 4px 20px rgba(34,197,94,0.3)';
    setTimeout(() => {
      btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg> Mesajı Gönder`;
      btn.style.background = '';
      btn.style.boxShadow = '';
      form.reset();
    }, 3000);
  });

  /* ─── MapLibre map: lazy init via IntersectionObserver ─── */
  let mapTries = 0;
  function initOzMap() {
    const ml = (window as any).maplibregl;
    if (!ml) {
      if (mapTries++ < 50) setTimeout(initOzMap, 250);
      return;
    }
    const el = document.getElementById('ozkartal-map');
    if (!el || (el as any).__inited) return;
    (el as any).__inited = true;

    let cfg: any = {};
    try { cfg = JSON.parse(localStorage.getItem('oz-config') || '{}'); } catch {}
    const lng = Number(cfg.mapLng) || 39.2272;
    const lat = Number(cfg.mapLat) || 38.6810;

    const gmapsBtn = document.getElementById('map-open-gmaps') as HTMLAnchorElement;
    if (gmapsBtn) {
      gmapsBtn.href = cfg.mapsLink || `https://www.google.com/maps?q=${lat},${lng}`;
    }

    try {
      const map = new ml.Map({
        container: 'ozkartal-map',
        style: 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json',
        center: [lng, lat],
        zoom: 13.5,
        attributionControl: { compact: true },
        cooperativeGestures: false,
        // Mobile optimizations
        antialias: false,
        maxZoom: 18,
        minZoom: 8,
      });

      map.addControl(new ml.NavigationControl({ showCompass: false }), 'top-right');

      map.on('load', () => {
        // Resize fix: forces canvas to actual container size
        map.resize();
        const markerEl = document.createElement('div');
        markerEl.className = 'oz-marker';
        const popup = new ml.Popup({ offset: 22, closeButton: false }).setHTML(
          `<strong>Öz</strong><strong>Kartal</strong> <span style="color:#a3a3a3">İletişim</span><br/>
           <span style="font-size:0.78rem;color:rgba(255,255,255,0.7)">${cfg.address || 'Elazığ, Türkiye'}</span><br/>
           <span style="font-size:0.72rem;color:rgba(255,107,53,0.9)">${cfg.hours || 'Pzt-Cmt: 09:00 - 19:00'}</span>`
        );
        new ml.Marker({ element: markerEl }).setLngLat([lng, lat]).setPopup(popup).addTo(map);
        popup.addTo(map).setLngLat([lng, lat]);
      });

      // Resize when window changes (mobile orientation)
      window.addEventListener('resize', () => setTimeout(() => map.resize(), 100), { passive: true });
    } catch (err) {
      console.error('MapLibre init failed:', err);
      (el as any).__inited = false;
      // Fallback: show static fallback
      el.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:12px;padding:20px;text-align:center">
          <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.6">
            <path d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0L6.343 16.657a8 8 0 1111.314 0z"/>
            <circle cx="12" cy="11" r="3"/>
          </svg>
          <p style="color:rgba(255,255,255,0.7);font-size:0.86rem">Harita yüklenemedi.<br/>
          <a href="${cfg.mapsLink || `https://www.google.com/maps?q=${lat},${lng}`}" target="_blank" rel="noopener noreferrer" style="color:#FF6B35;text-decoration:underline">Google Maps'te Aç</a></p>
        </div>`;
    }
  }

  // Use IntersectionObserver: init when contact section becomes visible
  function setupMapObserver() {
    const target = document.getElementById('ozkartal-map');
    if (!target) return;
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            initOzMap();
            io.disconnect();
          }
        });
      }, { rootMargin: '200px' });
      io.observe(target);
    } else {
      initOzMap();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMapObserver);
  } else {
    setupMapObserver();
  }
</script>
