---

<section id="hizmetler-detay" class="pricing-section" aria-labelledby="pricing-title">
  <!-- Ambient blob -->
  <div class="pricing-blob" aria-hidden="true"></div>

  <div class="container">
    <div class="section-header reveal" style="text-align:center;max-width:580px;margin:0 auto 56px">
      <div class="section-label">
        <span style="width:6px;height:6px;background:#FF6B35;border-radius:50%;display:inline-block;box-shadow:0 0 8px #FF6B35"></span>
        Detaylı Hizmetler
      </div>
      <h2 id="pricing-title" class="section-title" style="margin:16px 0 12px">
        Her Sorun İçin<br/>
        <span class="gradient-text">Bir Çözüm Var</span>
      </h2>
      <p class="section-sub">
        Cihazın durumu farklı olduğu için fiyatlar incelemeden sonra netleşir.
        Aklınızdaki herhangi bir hizmet için bize ulaşın, detayları paylaşalım.
      </p>
    </div>

    <div class="pricing-grid">
      {categories.map((c, i) => (
        <div class={`pricing-card card tilt reveal reveal-d${(i % 4) + 1} ${c.featured ? 'pricing-featured' : ''}`} data-tilt>
          <div class="tilt-inner">
            {c.featured && <div class="featured-badge">Öne Çıkan</div>}

            <div class="pricing-header">
              <div class="pricing-icon">
                <Fragment set:html={c.icon} />
              </div>
              <h3 class="pricing-name">{c.name}</h3>
            </div>

            <ul class="pricing-items" aria-label={c.name + ' hizmet kapsamı'}>
              {c.items.map(item => (
                <li class="pricing-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" stroke="#FF6B35" stroke-width="1.4" opacity="0.5"/>
                    <path d="M9 12l2 2 4-4" stroke="#FF6B35" stroke-width="2" fill="none"/>
                  </svg>
                  {item}
                </li>
              ))}
              <li class="pricing-item pricing-item-more">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" stroke="rgba(255,107,53,0.45)" stroke-width="1.4" stroke-dasharray="3 3"/>
                  <path d="M8 12h8M12 8v8" stroke="#FF6B35" stroke-width="1.5"/>
                </svg>
                ve daha fazlası...
              </li>
            </ul>

            <a href="#iletisim" class="pricing-cta">
              <span>Bu Kategori İçin İletişime Geç</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>

            <p class="pricing-note">
              Fiyat ve süre, cihaz incelendikten sonra net olarak paylaşılır.
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust strip — honest values, no guarantees -->
    <div class="trust-strip reveal">
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
          </svg>
        </div>
        <div>
          <strong>Ücretsiz İnceleme</strong>
          <span>Cihazı görmeden teklif vermiyoruz</span>
        </div>
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
          </svg>
        </div>
        <div>
          <strong>Şeffaf İletişim</strong>
          <span>Her aşamada bilgilendirme</span>
        </div>
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div>
          <strong>Özenli Çalışma</strong>
          <span>Detaya odaklı işçilik</span>
        </div>
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="1.5" aria-hidden="true">
            <path d="M12 2L4 7v10l8 5 8-5V7l-8-5z"/><path d="M12 22V12M12 12l8-5M12 12L4 7"/>
          </svg>
        </div>
        <div>
          <strong>Kaliteli Parça</strong>
          <span>Uygun yedek parça tercihi</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.pricing-section {
  padding: 110px 0;
  background: var(--bg);
  border-top: 1px solid rgba(255,255,255,0.04);
  position: relative;
  overflow: hidden;
}
.pricing-blob {
  position: absolute;
  width: 700px; height: 700px;
  top: -200px; right: -200px;
  background: radial-gradient(circle, rgba(255,107,53,0.06), transparent 70%);
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
}

.pricing-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18px;
  margin-bottom: 48px;
  position: relative;
  z-index: 1;
}
@media (min-width: 640px)  { .pricing-grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1200px) { .pricing-grid { grid-template-columns: repeat(4, 1fr); } }

.pricing-card {
  position: relative;
  overflow: visible;
}
.pricing-card .tilt-inner {
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  height: 100%;
}

.pricing-featured {
  border-color: rgba(255,107,53,0.42);
  background:
    linear-gradient(160deg, rgba(255,107,53,0.08) 0%, rgba(255,255,255,0.02) 60%),
    rgba(255,255,255,0.02);
}
.pricing-featured:hover {
  border-color: rgba(255,107,53,0.6);
  box-shadow: 0 20px 50px rgba(255,107,53,0.18),
              0 0 0 1px rgba(255,107,53,0.1);
}

.featured-badge {
  position: absolute;
  top: -1px; left: 50%;
  transform: translateX(-50%);
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #fff;
  background: linear-gradient(135deg, #FF6B35, #E85D04);
  padding: 4px 12px;
  border-radius: 0 0 10px 10px;
  z-index: 2;
}

.pricing-header {
  display: flex;
  align-items: center;
  gap: 12px;
}
.pricing-icon {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 12px;
  background: rgba(255,107,53,0.1);
  border: 1px solid rgba(255,107,53,0.22);
  color: #FF6B35;
  flex-shrink: 0;
}
.pricing-name {
  font-size: 1.2rem;
  font-weight: 700;
  color: #F4F4F5;
}

.pricing-items {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.pricing-item {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 0.83rem;
  color: rgba(244,244,245,0.72);
  padding: 7px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.pricing-item:last-child { border-bottom: none; }
.pricing-item svg { flex-shrink: 0; }

.pricing-item-more {
  color: #FF6B35;
  font-weight: 600;
  font-style: italic;
  padding-top: 12px;
  margin-top: 4px;
  border-top: 1px dashed rgba(255,107,53,0.2);
  border-bottom: none;
}

.pricing-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 13px 16px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.82rem;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #FF6B35, #E85D04);
  border-radius: 12px;
  box-shadow: 0 8px 24px rgba(255,107,53,0.28);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  text-align: left;
}
.pricing-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(255,107,53,0.42);
}
.pricing-cta svg { transition: transform 0.2s; flex-shrink: 0; }
.pricing-cta:hover svg { transform: translateX(3px); }

.pricing-note {
  font-size: 0.72rem;
  color: rgba(244,244,245,0.4);
  text-align: center;
  line-height: 1.55;
}

/* Trust strip */
.trust-strip {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1px;
  padding: 1px;
  background: rgba(255,255,255,0.06);
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  z-index: 1;
}
@media (min-width: 640px)  { .trust-strip { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .trust-strip { grid-template-columns: repeat(4, 1fr); } }

.trust-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 22px 20px;
  background: rgba(10,10,18,0.98);
}
.trust-icon {
  width: 42px; height: 42px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,107,53,0.08);
  border: 1px solid rgba(255,107,53,0.18);
  border-radius: 12px;
  flex-shrink: 0;
}
.trust-item strong {
  display: block;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.9rem;
  font-weight: 700;
  color: #F4F4F5;
  margin-bottom: 2px;
}
.trust-item span {
  font-size: 0.76rem;
  color: rgba(244,244,245,0.5);
}
</style>

<script>
const tiltCards = document.querySelectorAll<HTMLElement>('.pricing-card[data-tilt]');
tiltCards.forEach(card => {
  const inner = card.querySelector<HTMLElement>('.tilt-inner');
  if (!inner) return;
  card.addEventListener('mousemove', (e) => {
    const r = card.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width;
    const y = (e.clientY - r.top) / r.height;
    inner.style.transform = `perspective(1000px) rotateX(${(0.5 - y) * 5}deg) rotateY(${(x - 0.5) * 6}deg) translateY(-3px)`;
  });
  card.addEventListener('mouseleave', () => {
    inner.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateY(0)';
  });
});
</script>
