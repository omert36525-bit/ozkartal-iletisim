---
interface Props {
  size?: number;
  showText?: boolean;
  textClass?: string;
}
const { size = 40, showText = true, textClass = '' } = Astro.props;
---
<a href="/" class="oz-logo" aria-label="ÖzKartal İletişim Ana Sayfa">
  <svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" class="oz-logo-mark">
    <defs>
      <linearGradient id="ozg-main" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FF6B35"/>
        <stop offset="55%" stop-color="#FF8C42"/>
        <stop offset="100%" stop-color="#F59E0B"/>
      </linearGradient>
      <linearGradient id="ozg-bolt" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#FFF4E0"/>
        <stop offset="50%" stop-color="#FFB068"/>
        <stop offset="100%" stop-color="#FF6B35"/>
      </linearGradient>
      <radialGradient id="ozg-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FF6B35" stop-opacity="0.6"/>
        <stop offset="100%" stop-color="#FF6B35" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <!-- Outer shield: rounded hexagonal chip body -->
    <path d="M24 3 L41 13 L41 35 L24 45 L7 35 L7 13 Z"
          fill="url(#ozg-main)" fill-opacity="0.12"
          stroke="url(#ozg-main)" stroke-width="1.8" stroke-linejoin="round"/>

    <!-- Inner shield: smaller hex outline (depth) -->
    <path d="M24 9 L36 16 L36 32 L24 39 L12 32 L12 16 Z"
          fill="none"
          stroke="url(#ozg-main)" stroke-width="0.8" stroke-opacity="0.45" stroke-linejoin="round"/>

    <!-- Circuit traces from hex corners (electronics motif) -->
    <path d="M7 13 L4 11 M41 13 L44 11 M41 35 L44 37 M7 35 L4 37"
          stroke="url(#ozg-main)" stroke-width="1.4" stroke-linecap="round"/>
    <!-- Tiny solder pads at end of traces -->
    <circle cx="4" cy="11" r="1.2" fill="url(#ozg-main)"/>
    <circle cx="44" cy="11" r="1.2" fill="url(#ozg-main)"/>
    <circle cx="44" cy="37" r="1.2" fill="url(#ozg-main)"/>
    <circle cx="4" cy="37" r="1.2" fill="url(#ozg-main)"/>

    <!-- Center glow (subtle backlight) -->
    <circle cx="24" cy="24" r="11" fill="url(#ozg-glow)"/>

    <!-- CORE: stylized lightning bolt (energy / repair power) -->
    <path d="M26 14 L18 26 L23 26 L21 34 L30 21 L25 21 L26 14 Z"
          fill="url(#ozg-bolt)"
          stroke="#FF6B35" stroke-width="0.4" stroke-linejoin="round">
      <animate attributeName="opacity" values="1;0.8;1" dur="2.4s" repeatCount="indefinite"/>
    </path>
  </svg>

  {showText && (
    <span class={`oz-logo-text ${textClass}`}>
      <span class="oz-logo-orange" data-cfg="logoOz">Öz</span><span data-cfg="logoRest">Kartal</span>
    </span>
  )}
</a>

<style>
.oz-logo {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.oz-logo:hover {
  opacity: 0.92;
  transform: scale(1.03);
}
.oz-logo-mark {
  display: block;
  flex-shrink: 0;
  filter: drop-shadow(0 4px 14px rgba(255,107,53,0.35));
}
.oz-logo-text {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.12rem;
  font-weight: 700;
  color: #F4F4F5;
  letter-spacing: -0.02em;
  line-height: 1;
  white-space: nowrap;
}
.oz-logo-orange {
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
</style>
