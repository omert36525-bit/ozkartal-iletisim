---
import Logo from './Logo.astro';
const currentYear = new Date().getFullYear();

const links = {
  'Hizmetler': [
    { href: '#hizmetler', label: 'Telefon Tamiri' },
    { href: '#hizmetler', label: 'Drone Servisi' },
    { href: '#hizmetler', label: 'Elektronik Onarım' },
    { href: '#hizmetler-detay',  label: 'Detaylı Hizmetler' },
  ],
  'Şirket': [
    { href: '#nasil-calisir', label: 'Nasıl Çalışır' },
    { href: '#galeri',        label: 'Çalışmalarımız' },
    { href: '#sss',           label: 'Sık Sorulan Sorular' },
    { href: '#iletisim',      label: 'İletişim' },
  ],
};
---

<footer class="footer" role="contentinfo">
  <div class="footer-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <Logo size={32} />
        <p class="footer-tagline" data-cfg="footerTagline">
          Elazığ'da telefon, drone ve elektronik cihazlar için
          özenli teknik servis. Şeffaf süreç, deneyimli ekip.
        </p>

        <div class="footer-social" aria-label="Sosyal medya">
          {[
            {
              href: '#',
              label: 'Instagram',
              svg: `<path d="M16 4c-3.264 0-3.672.014-4.948.072-3.258.148-4.771 1.691-4.919 4.919-.058 1.265-.072 1.645-.072 4.831 0 3.204.013 3.583.07 4.849.149 3.225 1.664 4.771 4.919 4.919 1.266.058 1.644.07 4.85.07 3.204 0 3.583-.012 4.849-.07 3.26-.149 4.771-1.699 4.919-4.92.058-1.265.07-1.644.07-4.849 0-3.204-.012-3.583-.07-4.849-.149-3.227-1.664-4.771-4.919-4.919-1.266-.057-1.644-.071-4.85-.071zm0 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.07 1.644.07 4.849 0 3.259-.012 3.667-.07 4.947-.148 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.28-.07-1.688-.07-4.948 0-3.259.013-3.667.07-4.947.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0 3.678c-2.405 0-4.36 1.954-4.36 4.36 0 2.405 1.955 4.358 4.36 4.358 2.405 0 4.358-1.953 4.358-4.359 0-2.405-1.953-4.359-4.358-4.359zm0 7.191c-1.564 0-2.833-1.269-2.833-2.832 0-1.563 1.269-2.832 2.833-2.832 1.563 0 2.832 1.269 2.832 2.832 0 1.563-1.269 2.832-2.832 2.832zm5.558-8.205c-.563 0-1.02.457-1.02 1.02 0 .563.457 1.02 1.02 1.02.563 0 1.02-.457 1.02-1.02 0-.563-.457-1.02-1.02-1.02z"/>`,
            },
            {
              href: '#',
              label: 'WhatsApp',
              svg: `<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487 1.892.817 2.633.887 3.583.745.578-.087 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.05 22a9.85 9.85 0 01-5.029-1.378l-3.59.939.957-3.503A9.86 9.86 0 0112.05 2.054c5.452 0 9.886 4.435 9.886 9.886 0 5.452-4.434 9.886-9.886 9.886z"/>`,
            },
            {
              href: '#',
              label: 'Facebook',
              svg: `<path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>`,
            },
          ].map(s => (
            <a href={s.href} class="social-link" aria-label={s.label} target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <Fragment set:html={s.svg} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      {Object.entries(links).map(([group, items]) => (
        <div class="footer-col">
          <h3 class="footer-col-title">{group}</h3>
          <ul class="footer-links" role="list">
            {items.map(link => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="footer-col">
        <h3 class="footer-col-title">İletişim</h3>
        <div class="footer-contact">
          <a href="tel:+904240000000" data-cfg-href="phone" class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="2" aria-hidden="true">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span data-cfg="phone">+90 (424) 000 00 00</span>
          </a>
          <a href="mailto:info@ozkartaliletisim.com" data-cfg-href="email" class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="2" aria-hidden="true">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span data-cfg="email">info@ozkartaliletisim.com</span>
          </a>
          <div class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="2" aria-hidden="true">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span data-cfg="address">Elazığ, Türkiye</span>
          </div>
          <div class="footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF6B35" stroke-width="2" aria-hidden="true">
              <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span data-cfg="hours">Pzt-Cmt: 09:00-19:00</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy" data-cfg="footerCopyright">
        © {currentYear} ÖzKartal İletişim. Tüm hakları saklıdır.
      </p>
      <div class="footer-bottom-links">
        <a href="#" class="footer-bottom-link">Gizlilik Politikası</a>
        <a href="#" class="footer-bottom-link">Kullanım Koşulları</a>
      </div>
    </div>
  </div>
</footer>

<style>
.footer {
  background: #07070c;
  border-top: 1px solid rgba(255,255,255,0.06);
  position: relative;
  padding: 80px 0 0;
}

.footer-glow {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 600px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,107,53,0.4), transparent);
}

.footer-inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  padding-bottom: 56px;
}
@media (min-width: 640px)  { .footer-inner { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1024px) { .footer-inner { grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; } }

.footer-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}
.footer-logo-text {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: #F4F4F5;
}
.footer-tagline {
  font-size: 0.87rem;
  color: rgba(244,244,245,0.4);
  line-height: 1.7;
  max-width: 320px;
  margin-bottom: 20px;
}

.footer-social {
  display: flex;
  gap: 8px;
}
.social-link {
  width: 38px; height: 38px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 10px;
  color: rgba(244,244,245,0.5);
  transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
}
.social-link:hover {
  background: rgba(255,107,53,0.1);
  border-color: rgba(255,107,53,0.3);
  color: #FF6B35;
  transform: translateY(-2px);
}

.footer-col-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(244,244,245,0.4);
  margin-bottom: 16px;
}

.footer-links { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.footer-link {
  font-size: 0.88rem;
  color: rgba(244,244,245,0.5);
  transition: color 0.2s;
}
.footer-link:hover { color: #FF6B35; }

.footer-contact { display: flex; flex-direction: column; gap: 10px; }
.footer-contact-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.83rem;
  color: rgba(244,244,245,0.5);
  transition: color 0.2s;
  text-decoration: none;
}
a.footer-contact-item:hover { color: #FF6B35; }

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.05);
  padding: 20px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.footer-copy {
  font-size: 0.78rem;
  color: rgba(244,244,245,0.25);
}
.footer-bottom-links { display: flex; gap: 16px; }
.footer-bottom-link {
  font-size: 0.78rem;
  color: rgba(244,244,245,0.25);
  transition: color 0.2s;
}
.footer-bottom-link:hover { color: rgba(244,244,245,0.5); }
</style>
