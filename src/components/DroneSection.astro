---
---

<section class="drone-section" aria-labelledby="drone-title">
  <div class="drone-bg" aria-hidden="true">
    <img
      src="https://images.pexels.com/photos/2876511/pexels-photo-2876511.jpeg?auto=compress&cs=tinysrgb&w=1600&h=900&dpr=1"
      alt=""
      loading="lazy"
      width="1600"
      height="900"
    />
    <div class="drone-overlay"></div>
  </div>

  <div class="drone-blob drone-blob-1" aria-hidden="true"></div>
  <div class="drone-blob drone-blob-2" aria-hidden="true"></div>

  <div class="container drone-content">
    <div class="drone-text reveal">
      <div class="section-label" style="margin-bottom:20px">
        <span style="width:6px;height:6px;background:#FF6B35;border-radius:50%;display:inline-block;box-shadow:0 0 8px #FF6B35"></span>
        Drone Servisi
      </div>
      <h2 id="drone-title" class="drone-title">
        Drone'unuz Yeniden<br/>
        <span class="gradient-text">Gökyüzünde</span>
      </h2>
      <p class="drone-desc">
        DJI Mini, DJI Air, DJI Mavic ve diğer drone markalarında deneyimli
        teknik servis. Motor değişiminden gimbal onarımına, ESC sorunlarından
        gövde tamirine kadar geniş kapsamlı çözümler.
      </p>

      <ul class="drone-features" aria-label="Drone servis kapsamı">
        {[
          'DJI Tüm Modeller',
          'Motor & ESC Onarımı',
          'Kamera Gimbal',
          'Kalibrasyon',
          'Yedek Parça',
          'Kumanda Tamiri',
        ].map(f => (
          <li class="drone-feature">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="#FF6B35" stroke-width="1.5"/>
              <path d="M9 12l2 2 4-4" stroke="#FF6B35" stroke-width="2" fill="none"/>
            </svg>
            {f}
          </li>
        ))}
      </ul>

      <a href="#iletisim" class="btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Drone için İletişime Geç
      </a>
    </div>

    <!-- Floating 3D drone illustration card -->
    <div class="drone-illust reveal reveal-d2">
      <div class="drone-illust-card">
        <div class="drone-illust-shine" aria-hidden="true"></div>
        <div class="drone-illust-label">
          <span class="drone-illust-dot"></span>
          Servis Anı
        </div>
        <img
          src="https://images.pexels.com/photos/336232/pexels-photo-336232.jpeg?auto=compress&cs=tinysrgb&w=600&h=600&dpr=1"
          alt="Servis için hazır drone"
          width="600"
          height="600"
          loading="lazy"
        />
        <div class="drone-illust-stats">
          <div class="drone-illust-stat">
            <span class="drone-illust-stat-num">DJI</span>
            <span class="drone-illust-stat-lbl">Modeller</span>
          </div>
          <div class="drone-illust-stat">
            <span class="drone-illust-stat-num">4K</span>
            <span class="drone-illust-stat-lbl">Kamera</span>
          </div>
          <div class="drone-illust-stat">
            <span class="drone-illust-stat-num">Tüm</span>
            <span class="drone-illust-stat-lbl">Parçalar</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.drone-section {
  position: relative;
  padding: 110px 0;
  overflow: hidden;
  background: #08080f;
}

.drone-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.drone-bg img {
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.18;
}
.drone-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(10,10,18,0.95) 30%, rgba(255,107,53,0.08) 100%);
}

.drone-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(80px);
}
.drone-blob-1 {
  width: 460px; height: 460px;
  background: radial-gradient(circle, rgba(255,107,53,0.18), transparent 70%);
  top: -120px; right: 10%;
  z-index: 1;
}
.drone-blob-2 {
  width: 340px; height: 340px;
  background: radial-gradient(circle, rgba(245,158,11,0.1), transparent 70%);
  bottom: 0; left: 0;
  z-index: 1;
}

.drone-content {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr;
  gap: 56px;
  align-items: center;
}
@media (min-width: 1024px) {
  .drone-content { grid-template-columns: 1fr 380px; gap: 72px; }
}

.drone-title {
  font-size: clamp(1.9rem, 4vw, 3rem);
  font-weight: 700;
  color: #F4F4F5;
  margin-bottom: 20px;
}
.drone-desc {
  font-size: 0.95rem;
  color: rgba(244,244,245,0.6);
  line-height: 1.75;
  margin-bottom: 28px;
  max-width: 540px;
}

.drone-features {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 32px;
  max-width: 480px;
}
.drone-feature {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.87rem;
  font-weight: 500;
  color: rgba(244,244,245,0.7);
}

/* 3D Illustration card */
.drone-illust {
  perspective: 1500px;
}
.drone-illust-card {
  background: linear-gradient(160deg, rgba(255,255,255,0.05) 0%, rgba(255,107,53,0.04) 100%);
  border: 1px solid rgba(255,107,53,0.22);
  border-radius: 24px;
  padding: 22px;
  position: relative;
  overflow: hidden;
  transform: rotateY(-6deg) rotateX(2deg);
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  box-shadow: 0 30px 80px rgba(0,0,0,0.5),
              0 0 0 1px rgba(255,107,53,0.05);
}
.drone-illust-card:hover {
  transform: rotateY(-3deg) rotateX(1deg) translateY(-6px);
}

.drone-illust-shine {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 0%, rgba(255,107,53,0.25), transparent 50%);
  pointer-events: none;
}

.drone-illust-label {
  position: absolute;
  top: 16px; left: 16px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: rgba(10,10,18,0.8);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,107,53,0.3);
  border-radius: 99px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #FFB68A;
  z-index: 3;
}
.drone-illust-dot {
  width: 6px; height: 6px;
  background: #FF6B35;
  border-radius: 50%;
  box-shadow: 0 0 8px #FF6B35;
  animation: pulse-dot 4.5s ease-in-out infinite;
}

.drone-illust-card img {
  width: 100%;
  height: 280px;
  object-fit: cover;
  border-radius: 16px;
  position: relative;
  z-index: 2;
}

.drone-illust-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 18px;
  position: relative;
  z-index: 2;
}
.drone-illust-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 12px 8px;
  background: rgba(10,10,18,0.7);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 12px;
  gap: 2px;
}
.drone-illust-stat-num {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: #FF6B35;
}
.drone-illust-stat-lbl {
  font-size: 0.7rem;
  color: rgba(244,244,245,0.5);
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.7); }
}
</style>
