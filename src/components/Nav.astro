---
import Logo from './Logo.astro';
const links = [
  { href: '#hizmetler',       label: 'Hizmetler',     i18n: 'nav-services'  },
  { href: '#nasil-calisir',   label: 'Nasıl Çalışır', i18n: 'nav-how'       },
  { href: '#galeri',          label: 'Galeri',         i18n: 'nav-gallery'   },
  { href: '#hizmetler-detay', label: 'Hizmet Detayı',  i18n: 'nav-detail'    },
  { href: '#iletisim',        label: 'İletişim',       i18n: 'nav-contact'   },
];
---

<header id="navbar" class="nav-header">
  <div class="container nav-inner">
    <Logo size={32} />

    <nav class="nav-links" aria-label="Ana navigasyon">
      {links.map(l => (
        <a href={l.href} class="nav-link" data-i18n={l.i18n}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <!-- Dil Toggle TR/EN -->
      <button id="lang-toggle" class="lang-btn" aria-label="Dil değiştir" title="Switch Language">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
        </svg>
        <span id="lang-label">TR</span>
      </button>
      <a href="#iletisim" class="btn-primary nav-cta" data-i18n="nav-cta">İletişime Geç</a>
      <button id="menu-toggle" class="hamburger" aria-label="Menü" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobil menü">
    <nav class="mobile-nav">
      {links.map(l => (
        <a href={l.href} class="mobile-link" data-i18n={l.i18n}>{l.label}</a>
      ))}
      <a href="#iletisim" class="btn-primary" data-i18n="nav-cta" style="margin-top:8px;justify-content:center">
        İletişime Geç
      </a>
    </nav>
  </div>
</header>

<style>
.nav-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 18px 0;
  transition: background 0.4s ease, backdrop-filter 0.4s ease, box-shadow 0.4s ease, padding 0.4s ease;
}
.nav-header.scrolled {
  background: rgba(10,10,18,0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 1px 0 rgba(255,255,255,0.06);
  padding: 12px 0;
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  flex-shrink: 0;
}
.nav-logo-text {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: #F4F4F5;
  letter-spacing: -0.02em;
}
.nav-logo-oz { color: #FF6B35; }

.nav-links {
  display: none;
  align-items: center;
  gap: 4px;
}
@media (min-width: 900px) { .nav-links { display: flex; } }

.nav-link {
  padding: 8px 14px;
  font-size: 0.875rem;
  font-weight: 500;
  color: rgba(244,244,245,0.7);
  border-radius: 8px;
  transition: color 0.2s, background 0.2s;
  text-decoration: none;
}
.nav-link:hover {
  color: #F4F4F5;
  background: rgba(255,255,255,0.05);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Dil değiştirme butonu */
.lang-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 11px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: rgba(244,244,245,0.65);
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
  white-space: nowrap;
}
.lang-btn:hover {
  background: rgba(255,107,53,0.1);
  border-color: rgba(255,107,53,0.3);
  color: #FF6B35;
}
.lang-btn.active-en {
  background: rgba(255,107,53,0.12);
  border-color: rgba(255,107,53,0.35);
  color: #FF6B35;
}
.nav-cta {
  display: none;
  padding: 10px 20px;
  font-size: 0.85rem;
}
@media (min-width: 640px) { .nav-cta { display: inline-flex; } }

.hamburger {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 8px;
  background: none;
  border: none;
  cursor: pointer;
  border-radius: 8px;
  transition: background 0.2s;
}
.hamburger:hover { background: rgba(255,255,255,0.06); }
.hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: #F4F4F5;
  border-radius: 2px;
  transition: transform 0.3s ease, opacity 0.3s ease;
}
.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

@media (min-width: 900px) { .hamburger { display: none; } }

.mobile-menu {
  display: none;
  padding: 12px 24px 20px;
  border-top: 1px solid rgba(255,255,255,0.06);
  background: rgba(10,10,18,0.95);
  backdrop-filter: blur(20px);
}
.mobile-menu.open { display: block; }

.mobile-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.mobile-link {
  padding: 12px 14px;
  font-size: 0.95rem;
  font-weight: 500;
  color: rgba(244,244,245,0.8);
  border-radius: 10px;
  transition: background 0.2s, color 0.2s;
}
.mobile-link:hover { background: rgba(255,255,255,0.05); color: #F4F4F5; }
</style>

<script>
  const navbar  = document.getElementById('navbar');
  const toggle  = document.getElementById('menu-toggle');
  const mobileM = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
    mobileM?.classList.toggle('open', open);
  });

  mobileM?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      toggle?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      mobileM.classList.remove('open');
    });
  });

  /* ─── TR / EN Dil Toggle ─── */
  const langBtn   = document.getElementById('lang-toggle');
  const langLabel = document.getElementById('lang-label');

  // Tüm çeviri çiftleri — data-i18n="key" → EN metni
  const EN: Record<string, string> = {
    // Nav
    'nav-services': 'Services',
    'nav-how':      'How It Works',
    'nav-gallery':  'Gallery',
    'nav-detail':   'Service Details',
    'nav-contact':  'Contact',
    'nav-cta':      'Get in Touch',
    // Hero
    'hero-label':   "Elazığ's Tech Service",
    'hero-line1':   'Your Device',
    'hero-line2':   'In Good Hands.',
    'hero-sub':     'Expert technical service for iPhone, Samsung, DJI and electronic devices. Free inspection, transparent process, experienced team.',
    'hero-cta1':    'Get in Touch',
    'hero-cta2':    'View Services',
    'hero-badge1':  'Free Inspection',
    'hero-badge2':  'Fast Process',
    'hero-badge3':  'Expert Team',
    'hero-scroll':  'Scroll Down',
    // Sections
    'svc-label':    'Our Services',
    'svc-title':    'What Do We Repair?',
    'svc-sub':      'Expert technical service for all your devices.',
    'how-label':    'How It Works',
    'how-title':    'Simple & Transparent',
    'stats-label':  'Our Track Record',
    'gallery-label':'Our Workshop',
    'gallery-title':'Real Repairs',
    'drone-label':  'Drone Service',
    'drone-title1': 'Your Drone Back in the',
    'drone-title2': 'Sky',
    'review-label': 'Customer Reviews',
    'review-title': 'What Our Customers Say',
    'faq-label':    'FAQ',
    'faq-title':    'Common Questions',
    'contact-label':'Contact',
    'contact-title':'Get in Touch',
    'contact-sub':  'Get a free inspection and quote.',
    'pricing-label':'Pricing',
    'pricing-title':'Service Pricing',
  };

  // Orijinal Türkçe metinleri sakla (ilk yüklemede)
  function saveTurkish() {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      if (!el.getAttribute('data-tr')) {
        el.setAttribute('data-tr', el.textContent?.trim() || '');
      }
    });
  }

  function applyLang(lang: string) {
    saveTurkish();
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n') || '';
      if (lang === 'en' && EN[key]) {
        el.textContent = EN[key];
      } else {
        const tr = el.getAttribute('data-tr');
        if (tr) el.textContent = tr;
      }
    });
    if (langLabel) langLabel.textContent = lang === 'en' ? 'EN' : 'TR';
    langBtn?.classList.toggle('active-en', lang === 'en');
    document.documentElement.setAttribute('lang', lang === 'en' ? 'en' : 'tr');
    localStorage.setItem('oz-lang', lang);
  }

  // Sayfa yüklenince kayıtlı dili uygula
  const savedLang = localStorage.getItem('oz-lang') || 'tr';
  if (savedLang === 'en') {
    // DOM hazır olduğunda uygula
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => applyLang('en'));
    } else {
      applyLang('en');
    }
  }

  langBtn?.addEventListener('click', () => {
    const current = localStorage.getItem('oz-lang') || 'tr';
    applyLang(current === 'tr' ? 'en' : 'tr');
  });
</script>
