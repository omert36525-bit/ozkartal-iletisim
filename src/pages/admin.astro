      <div ${G}><label ${L}>Yorum Metni</label><textarea id="t${i}-text" rows="2">${t.text || ''}</textarea></div>
      <div class="form-row-3">
        <div ${G}><label ${L}>İsim</label><input type="text" id="t${i}-name" value="${(t.name || '').replace(/"/g, '&quot;')}"/></div>
        <div ${G}><label ${L}>Şehir / Rol</label><input type="text" id="t${i}-role" value="${(t.role || '').replace(/"/g, '&quot;')}"/></div>
        <div ${G}><label ${L}>Hizmet Türü</label><input type="text" id="t${i}-service" value="${(t.service || '').replace(/"/g, '&quot;')}"/></div>
