---
// Admin panel — password: 14532332
// Full content management: text, images (URL + file upload), testimonials, FAQ, map, security
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>ÖzKartal Admin Paneli</title>
  <meta name="robots" content="noindex, nofollow"/>
  <meta http-equiv="X-Content-Type-Options" content="nosniff"/>
  <meta name="referrer" content="no-referrer"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#0A0A12; --surface:#14141f; --card:#1c1c2e;
      --orange:#FF6B35; --orange-dim:rgba(255,107,53,0.12);
      --text:#F4F4F5; --text-muted:#6B7280; --border:rgba(255,255,255,0.08);
      --green:#22c55e; --red:#ef4444;
    }
    body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh}
    h1,h2,h3{font-family:'Space Grotesk',sans-serif}

    /* LOGIN */
    #login-screen{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px}
    .login-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:40px;width:100%;max-width:380px;text-align:center;position:relative;overflow:hidden}
    .login-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--orange),transparent)}
    .login-logo{font-size:1.6rem;font-weight:700;margin-bottom:6px}
    .login-logo span{color:var(--orange)}
    .login-sub{font-size:0.85rem;color:var(--text-muted);margin-bottom:28px}
    .login-lock{font-size:2.5rem;margin-bottom:20px}
    .login-error{font-size:0.8rem;color:#ef4444;min-height:18px;margin-top:8px}
    .login-locked{background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);color:#ef4444;padding:10px 14px;border-radius:10px;font-size:0.82rem;margin:14px 0;display:none}
    .login-locked.show{display:block}
    .honey{position:absolute;left:-9999px;opacity:0;pointer-events:none}

    /* ADMIN LAYOUT */
    #admin-screen{display:none;min-height:100vh}
    .admin-sidebar{position:fixed;top:0;left:0;height:100vh;width:240px;background:var(--surface);border-right:1px solid var(--border);padding:24px 16px;display:flex;flex-direction:column;gap:4px;z-index:50;overflow-y:auto}
    .sidebar-logo{font-family:'Space Grotesk',sans-serif;font-size:1.05rem;font-weight:700;padding:0 8px 20px;border-bottom:1px solid var(--border);margin-bottom:8px}
    .sidebar-logo span{color:var(--orange)}
    .sidebar-link{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;font-size:0.86rem;font-weight:500;color:var(--text-muted);cursor:pointer;transition:background 0.2s,color 0.2s;border:none;background:none;width:100%;text-align:left}
    .sidebar-link:hover,.sidebar-link.active{background:var(--orange-dim);color:var(--orange)}
    .sidebar-sep{height:1px;background:var(--border);margin:8px 0}

    .admin-main{margin-left:240px;padding:32px;min-height:100vh}
    @media(max-width:768px){.admin-sidebar{transform:translateX(-100%)}.admin-sidebar.open{transform:translateX(0)}.admin-main{margin-left:0;padding:20px}}

    /* HEADER */
    .admin-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px}
    .admin-title{font-size:1.5rem;font-weight:700}
    .header-actions{display:flex;gap:8px}
    .badge-online{display:flex;align-items:center;gap:6px;padding:6px 14px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.25);border-radius:99px;font-size:0.78rem;font-weight:600;color:#22c55e}
    .badge-online::before{content:'';width:6px;height:6px;background:#22c55e;border-radius:50%;box-shadow:0 0 8px #22c55e;animation:pulse 2s ease-in-out infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

    /* PANELS */
    .panel{display:none}
    .panel.active{display:block}
    .section-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;margin-bottom:20px}
    .section-card h3{font-size:1rem;font-weight:700;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border)}
    .section-card h4{font-size:0.86rem;font-weight:600;margin:18px 0 10px;color:var(--orange)}

    /* FORM ELEMENTS */
    label{display:block;font-size:0.78rem;font-weight:600;color:var(--text-muted);margin-bottom:6px;font-family:'Space Grotesk',sans-serif}
    input,textarea,select{width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);border-radius:10px;padding:11px 14px;color:#F4F4F5;font-family:'DM Sans',sans-serif;font-size:0.88rem;transition:border-color 0.2s,box-shadow 0.2s;resize:vertical}
    input::placeholder,textarea::placeholder{color:rgba(255,255,255,0.32)}
    input:focus,textarea:focus,select:focus{outline:none;border-color:rgba(255,107,53,0.5);box-shadow:0 0 0 3px rgba(255,107,53,0.1)}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}
    @media(max-width:640px){.form-row,.form-row-3{grid-template-columns:1fr}}
    .form-group{margin-bottom:14px;display:flex;flex-direction:column;gap:6px}
    .form-group label{margin-bottom:0}
    .form-group input,.form-group textarea,.form-group select{display:block;width:100%}

    /* IMAGE PICKER (URL + file upload + preview) */
    .img-picker{display:flex;gap:10px;align-items:flex-start}
    .img-thumb{width:80px;height:56px;border-radius:8px;border:1px solid var(--border);background:#0d0d18;background-size:cover;background-position:center;flex-shrink:0;position:relative;overflow:hidden}
    .img-thumb::after{content:'?';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:1.2rem;opacity:0;transition:opacity 0.2s}
    .img-thumb[data-empty]::after{opacity:1}
    .img-fields{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px}
    .img-upload-btn{display:inline-flex;align-items:center;gap:6px;font-size:0.78rem;padding:6px 12px;background:var(--orange-dim);border:1px solid rgba(255,107,53,0.25);color:var(--orange);border-radius:8px;cursor:pointer;font-weight:600;transition:background 0.2s}
    .img-upload-btn:hover{background:rgba(255,107,53,0.18)}
    .img-upload-btn input{display:none}

    /* SAVE BAR */
    .save-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:16px;border-top:1px dashed var(--border);margin-top:16px;flex-wrap:wrap}
    .save-hint{font-size:0.78rem;color:var(--text-muted)}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;font-family:'Space Grotesk',sans-serif;font-size:0.85rem;font-weight:600;border-radius:10px;cursor:pointer;border:none;transition:transform 0.15s,box-shadow 0.2s,background 0.2s;text-decoration:none}
    .btn-save{background:linear-gradient(135deg,#FF6B35,#F59E0B);color:#fff;box-shadow:0 8px 24px rgba(255,107,53,0.38)}
    .btn-save:hover{transform:translateY(-1px);box-shadow:0 12px 32px rgba(255,107,53,0.55)}
    .btn-danger{background:rgba(239,68,68,0.12);color:#ef4444;border:1px solid rgba(239,68,68,0.3)}
    .btn-danger:hover{background:rgba(239,68,68,0.2)}
    .btn-ghost{background:rgba(255,255,255,0.04);color:var(--text);border:1px solid var(--border)}
    .btn-ghost:hover{background:rgba(255,255,255,0.08)}

    /* TOAST */
    #toast{position:fixed;bottom:24px;right:24px;background:var(--green);color:#fff;padding:14px 22px;border-radius:12px;font-weight:600;font-size:0.88rem;box-shadow:0 14px 36px rgba(34,197,94,0.4);transform:translateY(100px);opacity:0;transition:transform 0.4s,opacity 0.4s;pointer-events:none;z-index:200;font-family:'Space Grotesk',sans-serif}
    #toast.show{transform:translateY(0);opacity:1}
    #toast.error{background:var(--red);box-shadow:0 14px 36px rgba(239,68,68,0.4)}

    /* TESTIMONIAL CARD (4 fields) */
    .testimonial-card{background:rgba(255,255,255,0.025);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:14px}
    .testimonial-card .form-row{margin-bottom:10px}
    .test-num{display:inline-block;width:24px;height:24px;background:var(--orange);color:#fff;border-radius:50%;font-size:0.72rem;font-weight:700;text-align:center;line-height:24px;margin-right:8px;font-family:'Space Grotesk',sans-serif}

    /* SECURITY PANEL */
    .security-stat{display:flex;justify-content:space-between;padding:12px 14px;background:rgba(255,255,255,0.025);border-radius:10px;margin-bottom:8px;font-size:0.85rem}
    .security-stat span:last-child{color:var(--green);font-weight:600}
    .security-stat.bad span:last-child{color:var(--red)}

    /* MOBILE MENU */
    .mobile-menu-btn{display:none;position:fixed;top:14px;left:14px;z-index:60;background:var(--surface);border:1px solid var(--border);width:42px;height:42px;border-radius:10px;align-items:center;justify-content:center;cursor:pointer}
    @media(max-width:768px){.mobile-menu-btn{display:flex}}
  </style>
</head>
<body>

<!-- ═══════════════════════════ LOGIN ═══════════════════════════ -->
<div id="login-screen">
  <div class="login-card">
    <div class="login-lock">🔐</div>
    <div class="login-logo"><span>Öz</span>Kartal Admin</div>
    <div class="login-sub">Yönetim Paneline Giriş</div>

    <div id="login-locked-banner" class="login-locked">⚠ Çok fazla başarısız deneme. Lütfen <span id="lockout-seconds">60</span> saniye bekleyin.</div>

    <div class="form-group" style="text-align:left;margin-top:8px">
      <label>Şifre</label>
      <!-- Honeypot field (bots fill it, humans never see it) -->
      <input type="text" name="website" class="honey" tabindex="-1" autocomplete="off" id="honey-pot"/>
      <input type="password" id="pw-input" placeholder="••••••••" autocomplete="current-password" autofocus/>
    </div>
    <div id="login-error" class="login-error"></div>
    <button class="btn btn-save" style="width:100%;justify-content:center;margin-top:4px" id="btn-login">Giriş Yap</button>
    <p style="font-size:0.7rem;color:var(--text-muted);margin-top:18px;line-height:1.5">
      Bu panel SHA-256 ile şifrelenmiş, rate-limited ve honeypot korumalıdır.<br/>5 hatalı denemeden sonra 60sn kilitlenir.
    </p>
  </div>
</div>

<!-- ═══════════════════════════ ADMIN ═══════════════════════════ -->
<div id="admin-screen">
  <button class="mobile-menu-btn" id="mob-menu-btn" aria-label="Menü">☰</button>

  <aside class="admin-sidebar" id="sidebar">
    <div class="sidebar-logo"><span>Öz</span>Kartal Admin</div>

    <button class="sidebar-link active" data-panel="contact">📞 İletişim</button>
    <button class="sidebar-link" data-panel="hero">🎯 Hero</button>
    <button class="sidebar-link" data-panel="services">🔧 Hizmetler</button>
    <button class="sidebar-link" data-panel="gallery">🖼 Galeri</button>
    <button class="sidebar-link" data-panel="testimonials">💬 Yorumlar</button>
    <button class="sidebar-link" data-panel="faq">❓ S.S.S.</button>
    <button class="sidebar-link" data-panel="footer">🦶 Footer</button>
    <button class="sidebar-link" data-panel="seo">🔍 SEO & Logo</button>
    <button class="sidebar-link" data-panel="chat">💬 Canlı Sohbet</button>
    <button class="sidebar-link" data-panel="analytics">📊 Ziyaretçi Logları</button>
    <button class="sidebar-link" data-panel="security">🛡 Güvenlik</button>

    <div class="sidebar-sep"></div>
    <a href="/" target="_blank" class="sidebar-link" style="text-decoration:none">🌐 Siteyi Gör</a>
    <button class="sidebar-link" id="btn-export" style="color:var(--orange)">📥 Yedek Al</button>
    <button class="sidebar-link" id="btn-import" style="color:var(--orange)">📤 Yedek Yükle</button>
    <button class="sidebar-link" id="btn-reset" style="color:var(--red)">↺ Tümünü Sıfırla</button>
    <button class="sidebar-link" id="btn-logout" style="margin-top:auto;color:var(--red)">🚪 Çıkış</button>
  </aside>

  <main class="admin-main">
    <div class="admin-header">
      <h1 class="admin-title" id="page-title">İletişim Bilgileri</h1>
      <div class="header-actions">
        <div class="badge-online">Güvenli Oturum</div>
      </div>
    </div>

    <!-- ─── CONTACT ─── -->
    <div id="panel-contact" class="panel active">
      <div class="section-card">
        <h3>📞 İletişim Bilgileri</h3>
        <div class="form-row">
          <div class="form-group"><label>Telefon</label><input type="tel" id="c-phone"/></div>
          <div class="form-group"><label>WhatsApp (uluslararası)</label><input type="tel" id="c-whatsapp" placeholder="+904240000000"/></div>
        </div>
        <div class="form-group"><label>E-posta</label><input type="email" id="c-email"/></div>
        <div class="form-group"><label>Adres</label><input type="text" id="c-address"/></div>
        <div class="form-row">
          <div class="form-group"><label>Çalışma Saatleri</label><input type="text" id="c-hours"/></div>
          <div class="form-group"><label>Boş Bırak</label><input type="text" disabled placeholder="—" style="opacity:0.4"/></div>
        </div>

        <h4>Harita Konumu (MapLibre)</h4>
        <div class="form-row">
          <div class="form-group"><label>Boylam (Longitude)</label><input type="number" step="any" id="c-mapLng" placeholder="39.2272"/></div>
          <div class="form-group"><label>Enlem (Latitude)</label><input type="number" step="any" id="c-mapLat" placeholder="38.6810"/></div>
        </div>
        <div class="form-group">
          <label>Google Maps "Yol Tarifi" Linki (opsiyonel)</label>
          <input type="url" id="c-mapsLink" placeholder="https://maps.google.com/?q=..."/>
        </div>
        <p style="font-size:0.76rem;color:var(--text-muted);margin-top:-4px">
          Google Maps'te konumu açın → "Paylaş" → "Bağlantıyı kopyala" → buraya yapıştırın.
          Harita üzerinde "Google Maps'te Aç" butonu olarak görünür.
        </p>
        <button type="button" class="btn btn-ghost" id="btn-test-maps" style="margin-top:8px">🗺 Google Maps'te Aç (Test)</button>

        <div class="save-bar">
          <span class="save-hint">Kayıt sonrası sitede anında güncellenir.</span>
          <button class="btn btn-save" data-save="contact">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── HERO ─── -->
    <div id="panel-hero" class="panel">
      <div class="section-card">
        <h3>🎯 Hero Metinleri</h3>
        <div class="form-row">
          <div class="form-group"><label>Üst Satır</label><input type="text" id="h-line1"/></div>
          <div class="form-group"><label>Alt Satır (vurgulu)</label><input type="text" id="h-line2"/></div>
        </div>
        <div class="form-group"><label>Alt Açıklama</label><textarea id="h-sub" rows="3"></textarea></div>
        <div class="form-row">
          <div class="form-group"><label>CTA 1 (turuncu)</label><input type="text" id="h-cta1"/></div>
          <div class="form-group"><label>CTA 2 (outline)</label><input type="text" id="h-cta2"/></div>
        </div>
        <div class="save-bar">
          <span class="save-hint">3D Spline robotu sabittir (değiştirilemez).</span>
          <button class="btn btn-save" data-save="hero">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── SERVICES ─── -->
    <div id="panel-services" class="panel">
      <div class="section-card">
        <h3>🔧 4 Hizmet Kategorisi</h3>
        <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:18px">Başlık, açıklama ve görsel her bir kategoride değiştirilebilir.</p>
        <div id="services-list"></div>
        <div class="save-bar">
          <span class="save-hint">URL veya bilgisayardan dosya yükleyin.</span>
          <button class="btn btn-save" data-save="services">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── GALLERY ─── -->
    <div id="panel-gallery" class="panel">
      <div class="section-card">
        <h3>🖼 Galeri (6 Görsel)</h3>
        <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:18px">Makro çekim, lehim, tamir öncesi/sonrası fotoğrafları yükleyin.</p>
        <div id="gallery-list"></div>
        <div class="save-bar">
          <span class="save-hint">PC'den yükle veya URL yapıştır.</span>
          <button class="btn btn-save" data-save="gallery">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── TESTIMONIALS ─── -->
    <div id="panel-testimonials" class="panel">
      <div class="section-card">
        <h3>💬 Müşteri Yorumları (9 adet)</h3>
        <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:18px">Her yorumun metni, müşteri ismi, şehri ve hizmet türü.</p>
        <div id="testimonials-list"></div>
        <div class="save-bar">
          <span class="save-hint">Yorumların orijinal, kısa ve gerçekçi tutulması önerilir.</span>
          <button class="btn btn-save" data-save="testimonials">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── FAQ ─── -->
    <div id="panel-faq" class="panel">
      <div class="section-card">
        <h3>❓ Sıkça Sorulan Sorular</h3>
        <div id="faq-list"></div>
        <div class="save-bar">
          <span class="save-hint">Soru ve cevaplar müşteri itirazlarını karşılar.</span>
          <button class="btn btn-save" data-save="faq">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── FOOTER ─── -->
    <div id="panel-footer" class="panel">
      <div class="section-card">
        <h3>🦶 Footer</h3>
        <div class="form-group"><label>Tagline / Slogan</label><input type="text" id="f-tagline"/></div>
        <div class="form-group"><label>Telif Hakkı Yazısı</label><input type="text" id="f-copyright"/></div>
        <div class="save-bar">
          <span class="save-hint">Footer alt kısım metinleri.</span>
          <button class="btn btn-save" data-save="footer">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── SEO ─── -->
    <div id="panel-seo" class="panel">
      <div class="section-card">
        <h3>🔍 SEO & Site Logosu</h3>
        <div class="form-group"><label>Sayfa Başlığı (title)</label><input type="text" id="seo-title"/></div>
        <div class="form-group"><label>Meta Açıklama (description)</label><textarea id="seo-desc" rows="3"></textarea></div>
        <div class="form-row">
          <div class="form-group"><label>Logo Sol (turuncu)</label><input type="text" id="seo-logo1"/></div>
          <div class="form-group"><label>Logo Sağ (beyaz)</label><input type="text" id="seo-logo2"/></div>
        </div>
        <div class="save-bar">
          <span class="save-hint">Google'da görünen başlık ve açıklama.</span>
          <button class="btn btn-save" data-save="seo">💾 Kaydet</button>
        </div>
      </div>
    </div>

    <!-- ─── CHAT WIDGET ─── -->
    <div id="panel-chat" class="panel">
      <div class="section-card">
        <h3>💬 Canlı Sohbet (Chatbot)</h3>
        <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:18px">
          Sağ alttaki sohbet kutusunun ayarları. Şu an demo modunda — anahtar kelime tabanlı yanıt veriyor.
          İleride OpenAI veya başka bir AI servisi için API anahtarı eklenebilir.
        </p>

        <h4>Genel Ayarlar</h4>
        <div class="form-group">
          <label>Sohbet açılış mesajı (özelleştirme)</label>
          <textarea id="chat-greeting-text" rows="2" placeholder="Merhaba! 👋 ÖzKartal İletişim'e hoş geldiniz."></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Otomatik karşılama gecikmesi (saniye)</label>
            <input type="number" id="chat-prebubble-delay" min="0" max="60" placeholder="3.5"/>
          </div>
          <div class="form-group">
            <label>Karşılama metni (sağda balon)</label>
            <input type="text" id="chat-prebubble-text" placeholder="Merhaba! Size nasıl yardımcı olabilirim?"/>
          </div>
        </div>

        <h4>AI API (İleride)</h4>
        <div class="form-row">
          <div class="form-group">
            <label>AI Sağlayıcı</label>
            <select id="chat-ai-provider">
              <option value="demo">Demo (anahtar kelime)</option>
              <option value="openai">OpenAI (GPT)</option>
              <option value="anthropic">Anthropic (Claude)</option>
              <option value="custom">Özel endpoint</option>
            </select>
          </div>
          <div class="form-group">
            <label>API Key (gizli)</label>
            <input type="password" id="chat-ai-key" placeholder="sk-..." autocomplete="off"/>
          </div>
        </div>
        <p style="font-size:0.74rem;color:var(--text-muted);margin-top:-4px">
          ⚠ API key client-side saklanır. Production'da Vercel Edge Function üzerinden geçirilmesi tavsiye edilir.
        </p>

        <h4>Özel Yanıtlar (anahtar = cevap)</h4>
        <p style="font-size:0.78rem;color:var(--text-muted);margin-bottom:10px">
