/* ════════════════════════════════════════════════════════
   IMAGE PICKER (URL + File upload)
════════════════════════════════════════════════════════ */
function imagePickerHTML(id: string, url: string, label: string): string {
  const safeUrl = (url || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
  return `
    <label style="display:block;margin-bottom:6px;font-size:0.78rem;font-weight:600;color:var(--text-muted);font-family:'Space Grotesk',sans-serif">${label}</label>
    <div class="img-picker" style="display:flex;gap:10px;align-items:flex-start">
      <div class="img-thumb" id="thumb-${id}" ${url ? `style="background-image:url('${safeUrl}')"` : 'data-empty'}></div>
      <div class="img-fields" style="flex:1;min-width:0;display:flex;flex-direction:column;gap:8px">
        <input type="url" id="${id}" value="${safeUrl}" placeholder="https://..." oninput="window.previewImg('${id}')"/>
        <label class="img-upload-btn">📁 Bilgisayardan Yükle
          <input type="file" accept="image/*" onchange="window.uploadImg(event,'${id}')"/>
        </label>
      </div>
    </div>`;
}

;(window as any).previewImg = (id: string) => {
  const input = document.getElementById(id) as HTMLInputElement;
  const thumb = document.getElementById(`thumb-${id}`)!;
  if (input.value) {
    thumb.style.backgroundImage = `url('${input.value}')`;
    thumb.removeAttribute('data-empty');
  } else {
    thumb.style.backgroundImage = '';
    thumb.setAttribute('data-empty', '');
  }
};

;(window as any).uploadImg = (e: Event, id: string) => {
  const file = (e.target as HTMLInputElement).files?.[0];
  if (!file) return;
  if (file.size > 2 * 1024 * 1024) { showToast('Dosya 2MB\'dan büyük olamaz.', true); return; }
  const reader = new FileReader();
  reader.onload = () => {
    const dataUrl = reader.result as string;
    const input = document.getElementById(id) as HTMLInputElement;
    input.value = dataUrl;
    (window as any).previewImg(id);
    showToast('✓ Görsel yüklendi');
  };
  reader.readAsDataURL(file);
};

