<script>
/* ════════════════════════════════════════════════════════
   SECURITY — SHA-256 + rate-limit + honeypot
════════════════════════════════════════════════════════ */
const PW_HASH = '8355ef2a13a271e3f718b426ce037df7e7473b65fa83ba379a8de81ff8eafb4c'; // sha256("14532332")
const MAX_ATTEMPTS = 5;
const LOCKOUT_MS = 60 * 1000;

async function sha256(str: string): Promise<string> {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
}

// Constant-time string compare (prevents timing attacks)
function constantTimeEq(a: string, b: string): boolean {
  if (a.length !== b.length) return false;
  let result = 0;
  for (let i = 0; i < a.length; i++) result |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return result === 0;
}

function getLockState() {
  try { return JSON.parse(localStorage.getItem('oz-lock') || '{"attempts":0,"until":0}'); }
  catch { return { attempts: 0, until: 0 }; }
}
function setLockState(s: any) { localStorage.setItem('oz-lock', JSON.stringify(s)); }

let lockTimer: any = null;
function updateLockUI() {
  const banner = document.getElementById('login-locked-banner')!;
  const secEl  = document.getElementById('lockout-seconds')!;
  const input  = document.getElementById('pw-input') as HTMLInputElement;
  const btn    = document.getElementById('btn-login') as HTMLButtonElement;
  const st = getLockState();
  const now = Date.now();
  if (st.until > now) {
    const remain = Math.ceil((st.until - now) / 1000);
    banner.classList.add('show');
    secEl.textContent = String(remain);
    input.disabled = true;
    btn.disabled = true;
    btn.style.opacity = '0.4';
    if (!lockTimer) lockTimer = setInterval(updateLockUI, 1000);
  } else {
    banner.classList.remove('show');
    input.disabled = false;
    btn.disabled = false;
    btn.style.opacity = '1';
    if (lockTimer) { clearInterval(lockTimer); lockTimer = null; }
  }
}

async function doLogin() {
  const honey = (document.getElementById('honey-pot') as HTMLInputElement).value;
  if (honey) { showLoginErr('Geçersiz istek.'); return; } // bot caught

  const st = getLockState();
  if (st.until > Date.now()) { updateLockUI(); return; }

  const pw = (document.getElementById('pw-input') as HTMLInputElement).value;
  if (!pw) { showLoginErr('Şifre boş bırakılamaz.'); return; }

  const hash = await sha256(pw);
  if (constantTimeEq(hash, PW_HASH)) {
    setLockState({ attempts: 0, until: 0 });
    sessionStorage.setItem('oz-admin', '1');
    localStorage.setItem('oz-lastlogin', new Date().toISOString());
    showAdmin();
  } else {
    const attempts = st.attempts + 1;
    if (attempts >= MAX_ATTEMPTS) {
      setLockState({ attempts: 0, until: Date.now() + LOCKOUT_MS });
      showLoginErr(`Çok fazla başarısız deneme. ${LOCKOUT_MS/1000}sn beklemeniz gerekiyor.`);
      updateLockUI();
    } else {
      setLockState({ attempts, until: 0 });
      showLoginErr(`Hatalı şifre. ${MAX_ATTEMPTS - attempts} deneme kaldı.`);
    }
  }
}

function showLoginErr(msg: string) {
  const err = document.getElementById('login-error')!;
  err.textContent = msg;
  setTimeout(() => { if (err.textContent === msg) err.textContent = ''; }, 4000);
}

function showAdmin() {
  (document.getElementById('login-screen') as HTMLElement).style.display = 'none';
  (document.getElementById('admin-screen') as HTMLElement).style.display = 'block';
  loadAllValues();
  updateSecurityStats();
}

function doLogout() {
  sessionStorage.removeItem('oz-admin');
  location.reload();
}

function doLogoutAll() {
  if (!confirm('Tüm cihazlarda oturum sonlandırılacak. Onaylıyor musunuz?')) return;
  sessionStorage.clear();
  localStorage.removeItem('oz-admin-session');
  location.reload();
}

document.getElementById('btn-login')?.addEventListener('click', doLogin);
document.getElementById('pw-input')?.addEventListener('keydown', e => {
  if ((e as KeyboardEvent).key === 'Enter') doLogin();
});
document.getElementById('btn-logout')?.addEventListener('click', doLogout);
document.getElementById('btn-logout-all')?.addEventListener('click', doLogoutAll);

updateLockUI();
if (sessionStorage.getItem('oz-admin') === '1') showAdmin();

