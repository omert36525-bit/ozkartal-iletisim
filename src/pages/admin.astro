/* ════════════════════════════════════════════════════════
   SAVE
════════════════════════════════════════════════════════ */
function saveSection(section: string) {
  const cfg = getConfig();

  if (section === 'contact') {
    Object.assign(cfg, {
      phone: val('c-phone'), whatsapp: val('c-whatsapp'),
      email: val('c-email'), address: val('c-address'),
      hours: val('c-hours'),
      mapLng: val('c-mapLng'), mapLat: val('c-mapLat'),
      mapsLink: val('c-mapsLink'),
    });
  }
  if (section === 'hero') {
    Object.assign(cfg, {
      heroLine1: val('h-line1'), heroLine2: val('h-line2'),
      heroSub: val('h-sub'), heroCta1: val('h-cta1'), heroCta2: val('h-cta2'),
    });
  }
  if (section === 'services') {
    cfg.services = [0,1,2,3].map(i => ({
      title: val(`s${i}-title`),
      desc:  val(`s${i}-desc`),
      img:   val(`s${i}-img`),
    }));
  }
  if (section === 'gallery') {
    cfg.gallery = [0,1,2,3,4,5].map(i => val(`g${i}`));
  }
  if (section === 'testimonials') {
    cfg.testimonials = Array.from({length: 9}, (_, i) => ({
      text:    val(`t${i}-text`),
      name:    val(`t${i}-name`),
      role:    val(`t${i}-role`),
      service: val(`t${i}-service`),
    }));
  }
  if (section === 'faq') {
    cfg.faq = Array.from({length: 8}, (_, i) => ({
      q: val(`q${i}`), a: val(`a${i}`),
    }));
  }
  if (section === 'footer') {
    Object.assign(cfg, {
      footerTagline:   val('f-tagline'),
      footerCopyright: val('f-copyright'),
    });
  }
  if (section === 'seo') {
    Object.assign(cfg, {
      seoTitle: val('seo-title'), seoDesc: val('seo-desc'),
      logoOz: val('seo-logo1'), logoRest: val('seo-logo2'),
    });
  }
  if (section === 'chat') {
    Object.assign(cfg, {
      chatGreeting:       val('chat-greeting-text'),
      chatPrebubbleDelay: val('chat-prebubble-delay'),
      chatPrebubbleText:  val('chat-prebubble-text'),
      chatAiProvider:     val('chat-ai-provider'),
      chatAiKey:          val('chat-ai-key'),
      chatCustomReplies:  val('chat-custom-replies'),
    });
  }

  try {
    localStorage.setItem('oz-config', JSON.stringify(cfg));
    showToast('✓ Kaydedildi — site güncellendi');
  } catch (err) {
    showToast('Kayıt başarısız: depolama dolu', true);
  }
}

document.querySelectorAll('button[data-save]').forEach(b => {
  b.addEventListener('click', (e) => {
    const sec = (e.currentTarget as HTMLElement).dataset.save!;
    saveSection(sec);
  });
});

/* ════════════════════════════════════════════════════════
   TOAST
════════════════════════════════════════════════════════ */
function showToast(msg = '✓ Kaydedildi', isError = false) {
  const t = document.getElementById('toast')!;
  t.textContent = msg;
  t.classList.toggle('error', isError);
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

/* ════════════════════════════════════════════════════════
   EXPORT / IMPORT / RESET
════════════════════════════════════════════════════════ */
document.getElementById('btn-export')?.addEventListener('click', () => {
  const cfg = getConfig();
  const blob = new Blob([JSON.stringify(cfg, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `ozkartal-config-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(a.href);
  showToast('✓ Yedek indirildi');
});

document.getElementById('btn-import')?.addEventListener('click', () => {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = 'application/json';
  inp.onchange = () => {
    const file = inp.files?.[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const parsed = JSON.parse(reader.result as string);
        if (typeof parsed !== 'object' || parsed === null) throw new Error('invalid');
        localStorage.setItem('oz-config', JSON.stringify(parsed));
        loadAllValues();
        showToast('✓ Yedek yüklendi');
      } catch { showToast('Geçersiz JSON dosyası', true); }
    };
    reader.readAsText(file);
  };
  inp.click();
});

document.getElementById('btn-reset')?.addEventListener('click', () => {
  if (!confirm('Tüm değişiklikler silinecek. Emin misiniz?')) return;
  localStorage.removeItem('oz-config');
  loadAllValues();
  showToast('✓ Sıfırlandı');
});

/* ════════════════════════════════════════════════════════
   SECURITY STATS
════════════════════════════════════════════════════════ */
function updateSecurityStats() {
  const st = getLockState();
  const a = document.querySelector('#stat-attempts span:last-child');
  if (a) a.textContent = String(st.attempts || 0);
  const last = localStorage.getItem('oz-lastlogin');
  const l = document.querySelector('#stat-lastlogin span:last-child');
  if (l && last) {
    const d = new Date(last);
    l.textContent = d.toLocaleString('tr-TR');
  }
}

/* ════════════════════════════════════════════════════════
   ANALYTICS PANEL
════════════════════════════════════════════════════════ */
function loadAnalytics() {
  let log: any = { views: [], clicks: [] };
  try { log = JSON.parse(localStorage.getItem('oz-analytics') || '{"views":[],"clicks":[]}'); }
  catch {}

  const views: any[] = log.views || [];
  const clicks: any[] = log.clicks || [];

  // Totals
  document.getElementById('stat-views')!.textContent = String(views.length);
  document.getElementById('stat-clicks')!.textContent = String(clicks.length);

  // Device split
  const mobile = views.filter(v => v.ua === 'mobile').length;
  const desktop = views.length - mobile;
  const deviceEl = document.getElementById('stat-device');
  if (deviceEl) deviceEl.textContent = views.length ? `${mobile} / ${desktop}` : '—';

  // Last visit
  const last = views[views.length - 1];
  const lvEl = document.getElementById('stat-lastvisit');
  if (lvEl) lvEl.textContent = last ? new Date(last.t).toLocaleString('tr-TR') : '—';

  // Top clicks
  const counts: Record<string, number> = {};
  clicks.forEach(c => {
    const k = (c.label || '?').slice(0, 40);
    counts[k] = (counts[k] || 0) + 1;
  });
  const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, 8);
  const topEl = document.getElementById('top-clicks');
  if (topEl) {
    topEl.innerHTML = sorted.length
      ? sorted.map(([k, v]) => `<div style="display:flex;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,0.04);padding:4px 0">
          <span style="color:var(--text)">${escapeHtml(k)}</span>
          <strong style="color:var(--orange)">${v}</strong>
        </div>`).join('')
      : 'Henüz tıklama verisi yok.';
  }

  // Recent views
  const rvEl = document.getElementById('recent-views');
  if (rvEl) {
    const recent = views.slice(-20).reverse();
    rvEl.innerHTML = recent.length
      ? recent.map(v => `<div style="border-bottom:1px solid rgba(255,255,255,0.04);padding:4px 0">
          <span style="color:var(--orange);font-size:0.74rem">${new Date(v.t).toLocaleString('tr-TR')}</span>
          <span style="margin-left:10px">${escapeHtml(v.path || '/')}</span>
          <span style="color:var(--text-muted);margin-left:10px;font-size:0.74rem">[${v.ua || '?'} · ${v.w || '?'}px · ref:${escapeHtml(v.ref || 'direct')}]</span>
        </div>`).join('')
      : 'Henüz görüntüleme verisi yok.';
  }

  // Recent clicks
  const rcEl = document.getElementById('recent-clicks');
  if (rcEl) {
    const recent = clicks.slice(-20).reverse();
    rcEl.innerHTML = recent.length
      ? recent.map(c => `<div style="border-bottom:1px solid rgba(255,255,255,0.04);padding:4px 0">
          <span style="color:var(--orange);font-size:0.74rem">${new Date(c.t).toLocaleString('tr-TR')}</span>
          <span style="margin-left:10px">${escapeHtml(c.label || '?')}</span>
          <span style="color:var(--text-muted);margin-left:10px;font-size:0.74rem">${escapeHtml(c.href || '')}</span>
        </div>`).join('')
      : 'Henüz tıklama verisi yok.';
  }
}

function escapeHtml(s: string): string {
  const div = document.createElement('div');
  div.textContent = s;
  return div.innerHTML;
}

document.getElementById('btn-refresh-analytics')?.addEventListener('click', loadAnalytics);
document.getElementById('btn-clear-analytics')?.addEventListener('click', () => {
  if (!confirm('Tüm ziyaretçi logları silinecek. Emin misiniz?')) return;
  localStorage.removeItem('oz-analytics');
  loadAnalytics();
  showToast('✓ Loglar temizlendi');
});

// Refresh analytics when entering its panel
document.querySelectorAll('.sidebar-link[data-panel="analytics"]').forEach(b => {
  b.addEventListener('click', () => setTimeout(loadAnalytics, 50));
});

