      <h4 style="margin-top:0">Kategori ${i + 1}</h4>
      <div ${G}><label ${L}>Başlık</label><input type="text" id="s${i}-title" value="${(s.title || DEFAULT_SERVICES[i].title).replace(/"/g, '&quot;')}"/></div>
      <div ${G}><label ${L}>Açıklama</label><textarea id="s${i}-desc" rows="2">${s.desc || DEFAULT_SERVICES[i].desc}</textarea></div>
      <div ${G}>${imagePickerHTML(`s${i}-img`, s.img || DEFAULT_SERVICES[i].img, 'Görsel (Pexels URL veya PC yükleme)')}</div>
    `;
    wrap.appendChild(card);
  });
}

/* ════════════════════════════════════════════════════════
   GALLERY
════════════════════════════════════════════════════════ */
function buildGalleryList(urls: string[]) {
  const wrap = document.getElementById('gallery-list')!;
  wrap.innerHTML = '';
  for (let i = 0; i < 6; i++) {
    const url = urls[i] || '';
    const card = document.createElement('div');
    card.style.marginBottom = '18px';
    card.innerHTML = imagePickerHTML(`g${i}`, url, `Fotoğraf ${i + 1}`);
    wrap.appendChild(card);
  }
}

